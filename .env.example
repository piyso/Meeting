# BlueArkive Environment Variables
# Copy to .env and fill in your values

# ─── Mock Data Mode ─────────────────────────────────────────
# Set to 'true' for offline UI development (no Supabase needed)
# Set to 'false' for real backend connectivity
# NOTE: production builds refuse to run with 'true' (see vite.config.ts) —
# a packaged app in mock mode has no backend bridge at all.
USE_MOCK_DATA=false

# ─── Cloud Backend (Supabase — REQUIRED for cloud features) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
# Edge Functions base URL (piyapi-proxy, create-checkout, license-activate)
BLUEARKIVE_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1

# ─── PiyAPI Cloud Backend ────────────────────────────────────
BLUEARKIVE_API_URL=https://api.piyapi.cloud

# ─── Deepgram Cloud Transcription ───────────────────────────
DEEPGRAM_API_URL=https://api.deepgram.com/v1

# ─── BlueArkive Billing ─────────────────────────────────────
# Leave empty in dev (uses local billing-web at localhost:5173)
BLUEARKIVE_BILLING_URL=

# ─── Monitoring ─────────────────────────────────────────────
SENTRY_DSN=

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Build ──────────────────────────────────────────────────
NODE_ENV=development

# ─── Recording (optional) ──────────────────────────────────
# MAX_RECORDING_DURATION_MS=0
# AUTO_SAVE_INTERVAL_MS=30000
# WAL_CHECKPOINT_INTERVAL_MS=300000
# SESSION_TIMEOUT_MS=0

# ═══════════════════════════════════════════════════════════════
# SUPABASE EDGE FUNCTION SECRETS (set via `supabase secrets set`)
# ═══════════════════════════════════════════════════════════════
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=whsec_...
# LEMON_SQUEEZY_API_KEY=...
# LEMON_SQUEEZY_STORE_ID=...
# LEMON_WEBHOOK_SECRET=whsec_...
# LEMON_{STARTER,PRO,TEAM}_{MONTHLY,YEARLY}_VARIANT=...   (also maps purchases → tier in billing-webhook)
# WEBHOOK_SECRET=your_on_signup_webhook_secret            (REQUIRED — on-signup rejects all calls without it)
# PIYAPI_PARTNER_KEY=pk_live_bluearkive_...               (BlueArkive's PiyAPI partner key. With it every user is a
#                                                          partner-managed PiyAPI account on the `managed` plan; without
#                                                          it accounts are created by public sign-up, i.e. on PiyAPI's
#                                                          free plan: 1,000 memories. Needs migration 004. Server-side
#                                                          only — never put it in the desktop app's environment.)
# PIYAPI_BASE_URL=https://api.piyapi.cloud
# SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key

# ─── Update signing (optional, recommended for releases) ───────────
# Public half of the key that release manifests are signed with. When set at
# build time, the app installs an update on Windows/Linux only if the manifest
# on the update server carries a valid signature.
#   node scripts/update-signing.js keygen     # prints both halves
# Put the private half in the CI secret UPDATE_SIGNING_KEY — never in this file.
UPDATE_PUBLIC_KEY=
